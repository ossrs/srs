# srs_auto_headers.hpp for the Windows build, with the macros auto/auto_headers.sh writes for
# ./configure, in the same order. The options SRS_RTSP, SRS_GB28181, SRS_FFMPEG_FIT, SRS_SIMULATOR and
# SRS_UTEST set theirs; the rest have the values of a Windows build.
if(NOT DEFINED SRS_TRUNK_DIR)
  get_filename_component(SRS_TRUNK_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()

macro(srs_auto_macro name on)
  if(${on})
    string(APPEND body "#define ${name}\n#define ${name}_BOOL true\n")
  else()
    string(APPEND body "#undef ${name}\n#define ${name}_BOOL false\n")
  endif()
endmacro()

function(srs_write_auto_headers path)
  set(options)
  foreach(o SRS_RTSP SRS_GB28181 SRS_FFMPEG_FIT SRS_SIMULATOR SRS_UTEST)
    if(${o})
      list(APPEND options "-D${o}=ON")
    else()
      list(APPEND options "-D${o}=OFF")
    endif()
  endforeach()
  list(JOIN options " " options)

  # The configure switches of the features, in the order of ./configure, for the options2 of
  # /api/v1/features, which tools read as on Unix.
  set(switches "--https=on")
  foreach(pair "utest:SRS_UTEST" "srt:ON" "rtc:ON" "rtsp:SRS_RTSP" "gb28181:SRS_GB28181" "simulator:SRS_SIMULATOR"
          "ffmpeg-fit:SRS_FFMPEG_FIT" "ffmpeg-opus:OFF" "sanitizer:OFF")
    string(REPLACE ":" ";" pair "${pair}")
    list(GET pair 0 name)
    list(GET pair 1 on)
    if(${on})
      string(APPEND switches " --${name}=on")
    else()
      string(APPEND switches " --${name}=off")
    endif()
  endforeach()

  set(body "")
  string(APPEND body "#define SRS_UNAME \"${CMAKE_HOST_SYSTEM_NAME} ${CMAKE_HOST_SYSTEM_VERSION} ${CMAKE_HOST_SYSTEM_PROCESSOR}\"\n")
  string(APPEND body "#define SRS_USER_CONFIGURE \"${options}\"\n")
  string(APPEND body "#define SRS_CONFIGURE \"${switches}\"\n\n")
  srs_auto_macro(SRS_SRT ON)
  srs_auto_macro(SRS_CXX11 OFF)
  srs_auto_macro(SRS_CXX14 OFF)
  srs_auto_macro(SRS_BACKTRACE OFF)
  srs_auto_macro(SRS_RTC ON)
  srs_auto_macro(SRS_RTSP SRS_RTSP)
  srs_auto_macro(SRS_FFMPEG_FIT SRS_FFMPEG_FIT)
  srs_auto_macro(SRS_FFMPEG_OPUS OFF)
  srs_auto_macro(SRS_H265 ON)
  srs_auto_macro(SRS_SIMULATOR SRS_SIMULATOR)
  srs_auto_macro(SRS_HTTPS ON)
  srs_auto_macro(SRS_GB28181 SRS_GB28181)
  srs_auto_macro(SRS_UTEST SRS_UTEST)
  srs_auto_macro(SRS_FORCE_PUBLIC4UTEST SRS_UTEST)
  srs_auto_macro(SRS_FFMPEG_STUB ON)
  srs_auto_macro(SRS_GPERF OFF)
  srs_auto_macro(SRS_GPERF_MC OFF)
  srs_auto_macro(SRS_GPERF_MD OFF)
  srs_auto_macro(SRS_GPERF_MP OFF)
  srs_auto_macro(SRS_GPERF_CP OFF)
  srs_auto_macro(SRS_SANITIZER OFF)
  srs_auto_macro(SRS_SANITIZER_LOG OFF)
  srs_auto_macro(SRS_VALGRIND OFF)
  srs_auto_macro(SRS_VERBOSE OFF)
  srs_auto_macro(SRS_INFO OFF)
  srs_auto_macro(SRS_TRACE ON)
  srs_auto_macro(SRS_SINGLE_THREAD ON)
  srs_auto_macro(SRS_SIGNAL_API OFF)
  srs_auto_macro(SRS_LOG_LEVEL_V2 ON)
  srs_auto_macro(SRS_CROSSBUILD OFF)
  srs_auto_macro(SRS_OSX OFF)
  srs_auto_macro(SRS_DEBUG OFF)
  srs_auto_macro(SRS_DEBUG_STATS OFF)
  srs_auto_macro(SRS_DEBUG_NACK_DROP OFF)
  string(APPEND body "\n#define SRS_PREFIX \"/usr/local/srs\"\n")
  string(APPEND body "#define SRS_DEFAULT_CONFIG \"conf/srs.conf\"\n\n")

  string(APPEND body "#define RTMP_SIG_SRS_AUTHORS \"\\\n")
  file(STRINGS "${SRS_TRUNK_DIR}/AUTHORS.md" authors REGEX "^-")
  foreach(line IN LISTS authors)
    if(line MATCHES "`([^`]+)`")
      string(APPEND body "${CMAKE_MATCH_1} \\\n")
    endif()
  endforeach()
  string(APPEND body "\"\n\n#endif\n\n")

  # The runner configures this build on every run. A header that changes only in its build time would
  # build every file again, so the time is kept until something else in the header changes.
  set(head "// auto generated by the Windows CMake build\n#ifndef SRS_AUTO_HEADER_HPP\n#define SRS_AUTO_HEADER_HPP\n\n#define SRS_PACKAGER \"\"\n")
  if(EXISTS "${path}")
    file(READ "${path}" old)
    if(old MATCHES "#define SRS_BUILD_TS \"[^\"]*\"\n#define SRS_BUILD_DATE \"[^\"]*\"\n")
      if(old STREQUAL "${head}${CMAKE_MATCH_0}${body}")
        return()
      endif()
    endif()
  endif()
  string(TIMESTAMP ts "%s")
  string(TIMESTAMP date "%Y-%m-%d %H:%M:%S")
  file(WRITE "${path}" "${head}#define SRS_BUILD_TS \"${ts}\"\n#define SRS_BUILD_DATE \"${date}\"\n${body}")
endfunction()
