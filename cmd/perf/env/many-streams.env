# SRS runs with -e and only these variables: N streams, each with one RTMP
# publisher and two RTMP players. The shipped max_connections 1000 would stop
# the ramp at a config limit; admit the cap's three connections a stream, with
# some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
