# SRS runs with -e and only these variables: the SRT publisher and players on
# the SRT server at its default port 10080, SRT to SRT with no srt_to_rtmp
# (its default), and the other SRT settings at their defaults. RTMP listens
# too, since SRS always needs it. The shipped max_connections 1000 would stop
# the ramp at a config limit; admit the cap of every scenario, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_SRT_SERVER_ENABLED=on
SRS_SRT_SERVER_LISTEN=10080
SRS_VHOST_SRT_ENABLED=on
