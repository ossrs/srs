# SRS runs with -e and only these variables: N WHIP publishers, each of its
# own stream, and no player, by the HTTP API at 1985 with media on the RTC
# server at UDP 8000, as in whip-whep.env; rtc_to_rtmp stays at its default,
# off. The load shares SRS's network namespace, so the candidate is 127.0.0.1.
# RTMP listens too, since SRS always needs it. The shipped max_connections
# 1000 would stop the ramp at a config limit; admit the cap of every
# scenario, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_HTTP_API_ENABLED=on
SRS_HTTP_API_LISTEN=1985
SRS_RTC_SERVER_ENABLED=on
SRS_RTC_SERVER_LISTEN=8000
SRS_RTC_SERVER_CANDIDATE=127.0.0.1
SRS_VHOST_RTC_ENABLED=on
