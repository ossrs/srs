# SRS runs with -e and only these variables: the WHIP publisher by the HTTP
# API at 1985 with media on the RTC server at UDP 8000, as in the shipped
# rtc.conf, with rtc_to_rtmp, so SRS converts the stream to RTMP, transcoding
# the Opus to AAC, and the HTTP-FLV players on the HTTP server at 8080 with the
# shipped mount. guess_has_av is off, so each FLV header has audio and video:
# the bridge keeps no GOP cache and sends audio about a second before the first
# IDR, so with the shipped guess_has_av a player waiting for the stream writes
# an audio-only header and SRS drops every video tag (drop_if_not_match). The
# load shares SRS's network namespace, so the candidate is 127.0.0.1. RTMP
# listens too, since SRS always needs it. The shipped
# max_connections 1000 would stop the ramp at a config limit; admit the
# 40000-client cap plus the publisher, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_HTTP_API_ENABLED=on
SRS_HTTP_API_LISTEN=1985
SRS_RTC_SERVER_ENABLED=on
SRS_RTC_SERVER_LISTEN=8000
SRS_RTC_SERVER_CANDIDATE=127.0.0.1
SRS_VHOST_RTC_ENABLED=on
SRS_VHOST_RTC_RTC_TO_RTMP=on
SRS_HTTP_SERVER_ENABLED=on
SRS_HTTP_SERVER_LISTEN=8080
SRS_VHOST_HTTP_REMUX_ENABLED=on
SRS_VHOST_HTTP_REMUX_MOUNT=[vhost]/[app]/[stream].flv
SRS_VHOST_HTTP_REMUX_GUESS_HAS_AV=off
