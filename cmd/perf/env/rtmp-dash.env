# SRS runs with -e and only these variables: the RTMP publisher on 1935, DASH
# with the shipped defaults (10s segments, the MPD's 5s update period, a
# window of 5), and the DASH players on the HTTP server at 8080, which serves
# the DASH files from its default dir, the default dash_path. The shipped
# max_connections 1000 would stop the ramp at a config limit; admit the
# 40000-client cap plus the publisher, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_HTTP_SERVER_ENABLED=on
SRS_HTTP_SERVER_LISTEN=8080
SRS_VHOST_DASH_ENABLED=on
