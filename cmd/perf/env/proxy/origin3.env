# Origin 3 behind the proxy; like origin.env on its own ports.
SRS_RTMP_LISTEN=19371
SRS_HTTP_SERVER_LISTEN=8083
SRS_HTTP_API_ENABLED=on
SRS_HTTP_API_LISTEN=19871
SRS_RTC_SERVER_LISTEN=8003
SRS_SRT_SERVER_LISTEN=10083
SRS_HEARTBEAT_ENABLED=on
SRS_HEARTBEAT_INTERVAL=9
SRS_HEARTBEAT_URL=http://127.0.0.1:12025/api/v1/srs/register
SRS_HEARTBEAT_DEVICE_ID=origin3
SRS_HEARTBEAT_PORTS=on
