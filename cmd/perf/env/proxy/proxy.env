# The Go proxy of perf-up.sh -target proxy. It listens on SRS's default ports,
# so the load tool's clients are the same as for SRS, and the origins register
# at its system API with the memory load balancer. One core: GOMAXPROCS=1 on
# its one-CPU cpuset. Go pprof on loopback only, for the profile holds.
PROXY_RTMP_SERVER=1935
PROXY_HTTP_SERVER=8080
PROXY_HTTP_API=1985
PROXY_WEBRTC_SERVER=8000
PROXY_SRT_SERVER=10080
PROXY_SYSTEM_API=12025
PROXY_LOAD_BALANCER_TYPE=memory
PROXY_STATIC_FILES=/srs/trunk/research
GO_PPROF=127.0.0.1:6060
GOMAXPROCS=1
