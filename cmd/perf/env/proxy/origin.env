# Origin 1 behind the proxy, added after the scenario's env, so the scenario
# turns on what it serves and this file only moves the listen ports off the
# proxy's and registers with the proxy's system API. Its HTTP API lists its
# streams, so the load tool places one stream on each origin.
SRS_RTMP_LISTEN=19351
SRS_HTTP_SERVER_LISTEN=8081
SRS_HTTP_API_ENABLED=on
SRS_HTTP_API_LISTEN=19851
SRS_RTC_SERVER_LISTEN=8001
SRS_SRT_SERVER_LISTEN=10081
SRS_HEARTBEAT_ENABLED=on
SRS_HEARTBEAT_INTERVAL=9
SRS_HEARTBEAT_URL=http://127.0.0.1:12025/api/v1/srs/register
SRS_HEARTBEAT_DEVICE_ID=origin1
SRS_HEARTBEAT_PORTS=on
