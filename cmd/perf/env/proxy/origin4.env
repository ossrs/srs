# Origin 4 behind the proxy; like origin.env on its own ports.
SRS_RTMP_LISTEN=19381
SRS_HTTP_SERVER_LISTEN=8084
SRS_HTTP_API_ENABLED=on
SRS_HTTP_API_LISTEN=19881
SRS_RTC_SERVER_LISTEN=8004
SRS_SRT_SERVER_LISTEN=10084
SRS_HEARTBEAT_ENABLED=on
SRS_HEARTBEAT_INTERVAL=9
SRS_HEARTBEAT_URL=http://127.0.0.1:12025/api/v1/srs/register
SRS_HEARTBEAT_DEVICE_ID=origin4
SRS_HEARTBEAT_PORTS=on
