# SRS runs with -e and only these variables: the SRT publisher on the SRT
# server at its default port 10080, with srt_to_rtmp, so SRS converts the SRT
# stream to RTMP, and the RTMP players on 1935. The other SRT settings stay at
# their defaults. The shipped max_connections 1000 would stop the ramp at a
# config limit; admit the 40000-client cap plus the publisher, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_SRT_SERVER_ENABLED=on
SRS_SRT_SERVER_LISTEN=10080
SRS_VHOST_SRT_ENABLED=on
SRS_VHOST_SRT_SRT_TO_RTMP=on
