# SRS runs with -e and only these variables: the RTMP publisher on 1935, with
# rtmp_to_rtc (AAC transcoded to Opus), and the WHEP players by the HTTP API at
# 1985 with media on the RTC server at UDP 8000, as in the shipped rtc.conf.
# The load shares SRS's network namespace, so the candidate is 127.0.0.1. The
# shipped max_connections 1000 would stop the ramp at a config limit; admit the
# cap of every scenario, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_HTTP_API_ENABLED=on
SRS_HTTP_API_LISTEN=1985
SRS_RTC_SERVER_ENABLED=on
SRS_RTC_SERVER_LISTEN=8000
SRS_RTC_SERVER_CANDIDATE=127.0.0.1
SRS_VHOST_RTC_ENABLED=on
SRS_VHOST_RTC_RTMP_TO_RTC=on
