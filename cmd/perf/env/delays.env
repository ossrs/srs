# The delay probes' origin: it forwards every stream to the forward target, a
# second SRS in its network namespace (delays-forward.env), and an edge SRS
# (delays-edge.env) pulls from it; both are started by perf-up.sh beside it.
# The probes have a few players, so the shipped max_connections stays.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_VHOST_FORWARD_ENABLED=on
SRS_VHOST_FORWARD_DESTINATION=127.0.0.1:19351
