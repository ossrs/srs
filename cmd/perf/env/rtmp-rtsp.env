# SRS runs with -e and only these variables: the RTMP publisher on 1935, and
# the RTSP players on the RTSP server at 8554, as in the shipped rtsp.conf,
# with rtmp_to_rtsp. The shipped max_connections 1000 would stop the ramp at a
# config limit; admit the 40000-client cap plus the publisher, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_RTSP_SERVER_ENABLED=on
SRS_RTSP_SERVER_LISTEN=8554
SRS_VHOST_RTSP_ENABLED=on
SRS_VHOST_RTSP_RTMP_TO_RTSP=on
