# The delay probes' edge: it pulls each stream a player asks for from the
# origin over RTMP, with the shipped defaults, so a player here shows the lag
# the edge adds.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=19352
SRS_VHOST_CLUSTER_MODE=remote
SRS_VHOST_CLUSTER_ORIGIN=127.0.0.1:1935
