# SRS runs with -e and only these variables: N RTMP publishers, each of its
# own stream, and no player. The shipped max_connections 1000 would stop the
# ramp at a config limit; admit the 40000-client cap, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
