# SRS runs with -e and only these variables: the RTMP publisher on 1935, and
# the HTTP-TS players on the HTTP server at 8080, with http_remux mounted as
# TS instead of the shipped .flv mount. The shipped max_connections 1000 would
# stop the ramp at a config limit; admit the 40000-client cap plus the
# publisher, with some room.
SRS_DAEMON=off
SRS_SRS_LOG_TANK=console
SRS_RTMP_LISTEN=1935
SRS_MAX_CONNECTIONS=42000
SRS_HTTP_SERVER_ENABLED=on
SRS_HTTP_SERVER_LISTEN=8080
SRS_VHOST_HTTP_REMUX_ENABLED=on
SRS_VHOST_HTTP_REMUX_MOUNT=[vhost]/[app]/[stream].ts
